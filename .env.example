# Configuración local de Docker Compose.
# Copia este archivo a `.env` y cambia los valores que necesites.

# Puerto público del frontend Next.js.
AULA_HTTP_PORT=3000

# Secreto de aplicación. Cámbialo en cualquier despliegue real.
AULA_SECRET=cambia-este-secreto-por-uno-largo

# Ponlo a 1 solo cuando sirvas la app por HTTPS (TLS terminado delante).
AULA_SECURE_COOKIES=0

# Ejecución de Python en servidor.
AULA_EXEC_ENABLED=1
AULA_EXEC_TIMEOUT=10
AULA_EXEC_MEMORY_MB=1024
AULA_EXEC_CONCURRENT=2
AULA_EXEC_RUNS_PER_MINUTE=12

# Estudio de autoría (documentos → unidades con OpenCode).
# La API key se configura desde /estudio, no en este archivo.
AULA_AUTHORING_ENABLED=1
AULA_AUTHORING_TIMEOUT=1800
AULA_AUTHORING_MAX_UPLOAD_MB=25
AULA_AUTHORING_MAX_FILES=5
AULA_AUTHORING_MAX_CHARS=300000
AULA_AUTHORING_MAX_JOBS=3

# Zona horaria para actividad y rachas.
TZ=Europe/Madrid
